{
  "name": "sysscope",
  "version": "1.0.2",
  "description": "See which local AI models and dev workloads your Mac or Linux machine can actually run.",
  "bin": "bin/sysscope.js",
  "files": [
    "bin/",
    "audit-bundle.sh",
    "audit.sh",
    "lib_core.sh",
    "lib_report.sh",
    "mod_system.sh",
    "mod_cpu.sh",
    "mod_memory.sh",
    "mod_gpu.sh",
    "mod_storage.sh",
    "mod_power.sh",
    "mod_software.sh",
    "mod_ai.sh",
    "mod_recommend.sh",
    "build.sh",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bash build.sh",
    "audit": "bash audit.sh",
    "lint": "bash -c 'for f in *.sh; do bash -n \"$f\" || exit 1; done' && node --check bin/sysscope.js",
    "prepack": "bash build.sh"
  },
  "keywords": [
    "system-audit",
    "hardware",
    "ollama",
    "llm",
    "local-ai",
    "apple-silicon",
    "macos",
    "gpu",
    "cli",
    "diagnostics",
    "ai-readiness"
  ],
