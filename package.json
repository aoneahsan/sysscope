  "license": "MIT",
  "homepage": "https://github.com/aoneahsan/sysscope#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aoneahsan/sysscope.git"
  },
  "bugs": {
    "url": "https://github.com/aoneahsan/sysscope/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://aoneahsan.com/payment?project-id=sysscope&project-identifier=sysscope"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "engines": {
    "node": ">=14"
  }
}
